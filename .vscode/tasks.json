{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build C++ Project",
            "command": "g++",
            "args": [
                "-std=c++20",
                "-g",
                //"${workspaceFolder}/RayTracer/src/RayTracer.cpp",
                "${workspaceFolder}/RayTracer/src/**/*.cpp",
                "${workspaceFolder}/RayTracer/src/*.cpp",
                "-I",
                "${workspaceFolder}/RayTracer/src",
                "-o",
                "${workspaceFolder}/bin/output/main"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                {
                    "owner": "cpp",
                    "fileLocation": ["relative", "${workspaceFolder}"],
                    "pattern": {
                        "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                }
            ]
        }
    ]
}